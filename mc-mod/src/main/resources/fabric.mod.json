{
  "schemaVersion": 1,
  "id": "stellarcraft",
  "version": "${version}",
  "name": "StellarCraft",
  "description": "Play Stellar Blade as a Minecraft player: MC physics, inventory and HUD inside Stellar Blade's world, via a UE4SS C++ mod and shared memory.",
  "authors": [
    "StellarCraft"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.stellarcraft.StellarCraftMod"
    ]
  },
  "mixins": [
    "stellarcraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=21"
  }
}
